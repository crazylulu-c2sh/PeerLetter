#!/usr/bin/env bash
set -euo pipefail
checkout=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
usage() { printf '%s\n' 'Usage: setup claude|codex|pi|all [--preview] [--json]' '       setup update [--preview] [--yes] [--json]' '       setup --uninstall claude|codex|pi|all [--preview] [--json]' 'Installs user settings with automatic wake. Existing unrelated settings are preserved.' 'update fast-forwards this checkout after you confirm the incoming commits (--yes skips the question) and refreshes every installed agent.' '--json prints the full result as JSON on stdout; progress goes to stderr.'; }
if [[ ${1:-} == --help || ${1:-} == -h || $# == 0 ]]; then usage; exit 0; fi
uninstall=false update=false
if [[ $1 == --uninstall ]]; then uninstall=true; shift; fi
case ${1:-} in
  claude|codex|pi|all) client=$1; shift;;
  update) if $uninstall; then usage >&2; exit 1; fi; client=installed update=true; shift;;
  *) usage >&2; exit 1;;
esac
preview=false json=false yes=false
for option; do case $option in --preview) preview=true;; --json) json=true;; --yes) yes=true;; *) usage >&2; exit 1;; esac; done
if $yes && ! $update; then usage >&2; exit 1; fi
fail() { printf '%s\n' "$@" >&2; exit 1; }
# Progress (git, pnpm) goes to fd 3: stdout normally, stderr when stdout must stay pure JSON.
if $json; then exec 3>&2; else exec 3>&1; fi
if $update && [[ -z ${PEERLETTER_SETUP_PULLED:-} ]]; then
  repo() { git -C "$checkout" "$@"; }
  repo rev-parse --git-dir >/dev/null 2>&1 || fail "setup update needs the git clone at $checkout."
  [[ -z $(repo status --porcelain --untracked-files=no) ]] || fail "$checkout has local changes. Commit or stash them, then rerun setup update."
  repo rev-parse --verify --quiet '@{upstream}' >/dev/null || fail "The checked-out branch has no upstream. Check out main, then rerun setup update."
  repo fetch --quiet || fail 'Fetching the upstream branch failed; nothing was changed.'
  before=$(repo rev-parse --short HEAD) after=$(repo rev-parse --short '@{upstream}')
  repo merge-base --is-ancestor HEAD '@{upstream}' || fail "This checkout has commits that are not on $(repo rev-parse --abbrev-ref '@{upstream}'). Reconcile them, then rerun setup update."
  if [[ $before == "$after" ]]; then printf 'PeerLetter is up to date at %s.\n' "$before" >&3
  else
    { printf 'PeerLetter would update %s -> %s:\n' "$before" "$after"; repo log --oneline 'HEAD..@{upstream}'; } >&3
  fi
  if [[ $before != "$after" ]] && ! $preview; then
    # The pulled code then runs in every agent session's hooks, MCP and extension.
    if ! $yes; then
      [[ -t 0 ]] || fail 'setup update asks before applying new code. Review it with setup update --preview, then rerun in a terminal or pass --yes.'
      printf 'Review the changes with: git -C %q log -p HEAD..@{upstream}\nApply this update? [y/N] ' "$checkout" >&2
      read -r answer || answer=''
      [[ $answer == [yY] || $answer == [yY][eE][sS] ]] || fail 'Update cancelled; nothing was changed.'
    fi
    repo merge --ff-only --quiet '@{upstream}'
    printf 'PeerLetter updated %s -> %s.\n' "$before" "$after" >&3
    # Finish with the updated setup script, which may install differently.
    export PEERLETTER_SETUP_PULLED=1
    if $json; then exec "$checkout/setup" update --json; else exec "$checkout/setup" update; fi
  fi
fi
compatible() { "$1" -e 'const [a,b,c]=process.versions.node.split(".").map(Number);process.exit(a>24 || a===24 && (b>18 || b===18 && c>=0) ? 0:1)' >/dev/null 2>&1; }
selected_node=''
if [[ -n ${PEERLETTER_NODE:-} ]]; then
  if [[ $PEERLETTER_NODE != /* ]] || ! compatible "$PEERLETTER_NODE"; then printf '%s\n' 'PEERLETTER_NODE must be an absolute Node executable, version 24.18 or newer.' >&2; exit 1; fi
  selected_node=$PEERLETTER_NODE
else
  while IFS= read -r candidate; do
    if compatible "$candidate"; then selected_node=$candidate; break; fi
  done < <(type -aP node 2>/dev/null || true)
  if [[ -z $selected_node ]]; then
    for candidate in "${NVM_DIR:-$HOME/.nvm}"/versions/node/*/bin/node "$HOME"/.local/bin/node /usr/local/bin/node /usr/bin/node; do
      if [[ -x $candidate ]] && compatible "$candidate"; then selected_node=$candidate; break; fi
    done
  fi
fi
if [[ -z $selected_node ]]; then printf '%s\n' 'Node 24.18+ is required. Install it, then rerun setup.' 'With nvm: nvm install 24.18.0 && nvm use 24.18.0' >&2; exit 1; fi
selected_node=$("$selected_node" -e 'console.log(require("node:fs").realpathSync(process.argv[1]))' "$selected_node")
export PATH="$(dirname -- "$selected_node"):$PATH"
if ! $uninstall && ! $preview; then
  # pnpm 10+ switches itself to the packageManager version, so any pnpm 10+ is enough.
  package_command=()
  if command -v pnpm >/dev/null && [[ $(pnpm --version 2>/dev/null) =~ ^([0-9]+)\. ]] && (( BASH_REMATCH[1] >= 10 )); then package_command=(pnpm)
  elif command -v corepack >/dev/null; then package_command=(corepack pnpm)
  else printf 'Install pnpm 10+ or Corepack, then rerun setup.\n' >&2; exit 1; fi
  (cd -- "$checkout"; export COREPACK_ENABLE_DOWNLOAD_PROMPT=0; "${package_command[@]}" install --frozen-lockfile --ignore-scripts) >&3
fi
arguments=(--client "$client" --node "$selected_node")
if $uninstall; then arguments+=(--uninstall); fi
if $preview; then arguments+=(--preview); fi
if $json; then arguments+=(--json); fi
exec "$selected_node" "$checkout/scripts/global-install.ts" "${arguments[@]}"
