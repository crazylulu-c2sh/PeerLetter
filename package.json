{
  "name": "peerletter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "description": "Local agent mail over stdio MCP and shared SQLite",
  "engines": { "node": ">=24.18.0" },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:native-codex": "node scripts/native-codex-test.ts",
    "test:native-codex-queue": "node scripts/native-codex-queue-test.ts",
    "test:native-pi": "node scripts/native-pi-test.ts",
    "test:native-global-setup": "node scripts/native-global-setup-test.ts",
    "test:native-claude": "python3 scripts/native-claude-test.py",
    "check": "tsc --noEmit",
    "stdio": "node src/stdio.ts",
    "cli": "node src/cli.ts",
    "prepublishOnly": "node -e \"throw new Error('PeerLetter is GitHub-only. Registry publishing is disabled.')\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "ws": "8.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@types/node": "26.6.4",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
